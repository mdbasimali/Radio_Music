{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.90sgaana.in" }],
      "destination": "https://90sgaana.in/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!assets/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ]

}
